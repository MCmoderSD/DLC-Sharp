<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>

        <!-- Build -->
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Test project -->
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>

    </PropertyGroup>

    <ItemGroup>

        <!-- Test framework and code coverage -->
        <PackageReference Include="xunit.v3" Version="4.0.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0"/>
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0"/>

        <!-- Project under test -->
        <ProjectReference Include="..\..\DlcSharp\DlcSharp.csproj"/>

        <!-- Makes the xUnit types available in every test file -->
        <Using Include="Xunit"/>

        <!-- Settings that restrict the coverage report to the library and leave out generated code -->
        <None Update="coverage.config" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>